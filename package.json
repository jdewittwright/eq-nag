{
  "name": "eqnag",
  "productName": "EQNag",
  "version": "0.3.0",
  "main": "main.js",
  "description": "An EverQuest Notification AGent",
  "license": "MIT",
  "author": {
    "name": "Guild Antix",
    "email": "srbmmo@gmail.com"
  },
  "scripts": {
    "copy-source-maps": "copyfiles --flat dist/*.map source-maps/%npm_package_version%",
    "tsc": "tsc",
    "ng": "ng",
    "start": "electron .",
    "test": "node tests/unit/app-logic.test.cjs && node tests/unit/share-files.test.cjs",
    "test:e2e": "node tests/e2e/overlay.test.cjs && node tests/e2e/app.test.cjs",
    "start:electron": "tsc && ng build --configuration=production && electron .",
    "perf": "node tools/perf/perf-test.mjs",
    "build": "npm run copy-source-maps && electron-builder build --win --publish never",
    "deploy": "npm run copy-source-maps && electron-builder build --win --publish always"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "^16.2.14",
    "@angular/common": "^16.2.12",
    "@angular/compiler": "^16.2.12",
    "@angular/core": "^16.2.12",
    "@angular/forms": "^16.2.12",
    "@angular/material": "^16.2.14",
    "@angular/platform-browser": "^16.2.12",
    "@angular/platform-browser-dynamic": "^16.2.12",
    "@angular/router": "^16.2.12",
    "@electron/remote": "^2.1.4",
    "@types/lodash-es": "^4.17.4",
    "active-win": "^8.1.1",
    "adm-zip": "^0.5.10",
    "archiver": "^5.3.0",
    "chokidar": "^3.4.0",
    "cron-parser": "^4.8.1",
    "dompurify": "3.4.16",
    "electron-log": "^5.4.0",
    "electron-unhandled": "^5.0.0",
    "electron-updater": "^6.8.11",
    "fuse.js": "^6.4.3",
    "glob": "^10.4.5",
    "handlebars": "^4.7.6",
    "lodash": "^4.17.15",
    "lodash-es": "^4.17.21",
    "nanoid": "^3.1.10",
    "ng-table-virtual-scroll": "^1.6.1",
    "ngx-markdown": "^16.0.0",
    "ngx-mat-timepicker": "^16.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.2",
    "tga2png": "^0.1.3",
    "tslib": "^2.0.0",
    "xml2js": "^0.4.23",
    "zone.js": "~0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular-devkit/schematics": "^16.2.16",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.12",
    "@types/node": "^16.18.50",
    "copyfiles": "^2.4.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^4.9.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdewittwright/eq-nag.git"
  },
  "build": {
    "productName": "EQ Nag",
    "appId": "scripter.eqNotificationAgent",
    "artifactName": "EQ-Nag-Setup-${version}.${ext}",
    "extraResources": [
      ".env"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "jdewittwright",
          "repo": "eq-nag",
          "releaseType": "draft"
        }
      ],
      "icon": "Nag.ico"
    },
    "portable": {
      "artifactName": "eq_nag_portable.exe"
    },
    "directories": {
      "output": "electron/output",
      "buildResources": "electron/buildResources"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!*.env",
      "!.angular",
      "!.vscode",
      "!tests",
      "!source-maps",
      "package.json",
      "!tsconfig*",
      "!readme*",
      "!angular.json",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  }
}
