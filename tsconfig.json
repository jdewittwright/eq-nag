{
    "compileOnSave": false,
    "compilerOptions": {
      // Lets the app import from 'src/...' (TypeScript 6 deprecates baseUrl).
      "paths": {
        "src/*": [ "./src/*" ]
      },
      // TypeScript 6 is strict by default; Nag never was.
      "strict": false,
      // TypeScript 6 no longer infers it.
      "rootDir": "./src",
      "outDir": "./out-tsc/app",
      "sourceMap": true,
      "declaration": false,
      "module": "es2020",
      "moduleResolution": "bundler",
      "experimentalDecorators": true,
      "importHelpers": true,
      "target": "ES2022",
      "typeRoots": [
        "node_modules/@types"
      ],
      "useDefineForClassFields": false
    },
    "angularCompilerOptions": {
      "strictTemplates": true
    }
}
